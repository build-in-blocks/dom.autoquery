{
  "compilerOptions": {
    "outDir": "./dist.prod",
    "rootDir": "./@lib",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "removeComments": false,
    "preserveConstEnums": true,
    //-------------------------------
    // simplify internal import paths
    //-------------------------------
    "paths": {
      "@/*": ["./@lib/*"],
      "@_types/*": ["./@lib/types/*"],
      "@_watcher/*": ["./@lib/watcher/*"]
    }
  },
  "include": ["@lib/**/*"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
